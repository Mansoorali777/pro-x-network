# Pro-X Network — backend secrets template.
#
# Copy this file to `.env` in this same folder (backend/supabase/.env)
# for LOCAL DEVELOPMENT ONLY (`supabase functions serve` reads it).
# For a deployed project, set these with `supabase secrets set` instead
# (see backend/README.md) — do not upload a .env file to Supabase.
#
# `.env` is listed in .gitignore. NEVER commit real values.
# NEVER paste real values into index.html, admin.html, or any file
# under config/ or js/ — those ship to every player's browser.

# --- Supabase (from Project Settings > API in the Supabase dashboard) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# all auto-injected by the Supabase platform for deployed Edge
# Functions. You only need to set them here for local
# `supabase functions serve` testing.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# No custom JWT signing secret is needed. auth-telegram issues real
# Supabase Auth sessions (admin.createUser + generateLink + verifyOtp),
# signed by Supabase's own Auth server — not by anything in this repo.

# --- Telegram ---
# Get this from @BotFather. Used to verify the signature of every
# Telegram WebApp initData payload — this is what makes Telegram
# identity trustworthy instead of just believing what the client says.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# --- Auth tuning (optional — has a sensible default, shown here) ---
# Reject a Telegram initData payload whose auth_date is older than
# this many seconds, to limit replay of a captured initData string.
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
# Session token lifetime is now controlled by your Supabase project's
# Auth settings (JWT expiry), not by an env var in this codebase.

# --- TON (placeholders for the future withdrawal step — leave blank
#     until that step; do not generate/paste real values yet) ---
TON_PRIVATE_KEY=
TON_WALLET_SEED_PHRASE=
